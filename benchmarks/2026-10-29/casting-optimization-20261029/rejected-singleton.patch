 from graflo.architecture.graph_types.transform import VertexRep
 
+_SCALAR_INDEX_TYPES = frozenset({str, int, float, bool, bytes, type(None)})
+
+
+def _keyed_singleton(doc: dict | VertexRep, index_keys: tuple[str, ...]) -> bool:
+    """Whether one ordinary observation can be copied without grouping it.
+
+    Keep custom mappings, keys and hash implementations on the general path:
+    grouping can reject an unhashable identity or invoke user-defined methods.
+    Non-identity values are still copied shallowly, as in the general path.
+    """
+    if type(doc) is VertexRep:
+        if type(doc.lookup_only) is not bool or (
+            doc.find is not None and type(doc.find) is not str
+        ):
+            return False
+        data = doc.vertex
+    elif type(doc) is dict:
+        data = doc
+    else:
+        return False
+    if (
+        type(data) is not dict
+        or type(index_keys) is not tuple
+        or not all(type(key) is str for key in index_keys)
+        or not all(type(key) is str for key in data)
+    ):
+        return False
+    found = False
+    for key in index_keys:
+        if key in data:
+            if type(data[key]) not in _SCALAR_INDEX_TYPES:
+                return False
+            found = True
+    return found
+
 
